{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timclass.cn/schemas/universal-learning-pack.v0.schema.json",
  "title": "Universal Learning Pack v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "version",
    "title",
    "objectives",
    "tasks"
  ],
  "properties": {
    "kind": {
      "const": "LearningPack"
    },
    "id": {
      "$ref": "#/$defs/stableId"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "maxLength": 240
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 20
    },
    "audience": {
      "$ref": "#/$defs/audience"
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/objective"
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 240,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ageMin": {
          "type": "integer",
          "minimum": 3,
          "maximum": 18
        },
        "ageMax": {
          "type": "integer",
          "minimum": 3,
          "maximum": 18
        },
        "levelTags": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "domain",
        "skill"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "skill": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "conceptIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "objectiveIds",
        "interactionTemplateRef",
        "evaluatorRef",
        "content",
        "evaluatorConfig",
        "feedback"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "objectiveIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "interactionTemplateRef": {
          "$ref": "#/$defs/stableId"
        },
        "presentationRef": {
          "$ref": "#/$defs/stableId"
        },
        "evaluatorRef": {
          "$ref": "#/$defs/stableId"
        },
        "content": {
          "$ref": "#/$defs/content"
        },
        "evaluatorConfig": {
          "$ref": "#/$defs/evaluatorConfig"
        },
        "feedback": {
          "$ref": "#/$defs/feedback"
        },
        "activityBindings": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/activityBinding"
          }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promptText"
      ],
      "properties": {
        "promptText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "ttsText": {
          "type": "string",
          "maxLength": 500
        },
        "cueText": {
          "type": "string",
          "maxLength": 160
        },
        "responseScaffold": {
          "type": "string",
          "maxLength": 500
        },
        "mediaRefs": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "choiceIds": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      }
    },
    "evaluatorConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredConceptIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "requiredSlotIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "minimumCompletenessRef": {
          "$ref": "#/$defs/stableId"
        },
        "acceptedChoiceIds": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "expectedSequenceIds": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "teacherRubricRef": {
          "$ref": "#/$defs/stableId"
        }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelContent"
      ],
      "properties": {
        "acceptedText": {
          "type": "string",
          "maxLength": 160
        },
        "retryHint": {
          "type": "string",
          "maxLength": 240
        },
        "modelContent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "activityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "templateRef",
        "content"
      ],
      "properties": {
        "templateRef": {
          "$ref": "#/$defs/stableId"
        },
        "parameterRef": {
          "$ref": "#/$defs/stableId"
        },
        "content": {
          "$ref": "#/$defs/activityContent"
        }
      }
    },
    "activityContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "instruction",
        "target"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "challenge": {
          "type": "string",
          "maxLength": 500
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
