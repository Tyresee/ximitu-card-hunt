{
  "name":"ximitu-card-hunt",
  "version":"2.1.1",
  "private":true,
  "type":"module",
  "description":"云港星星大冒险，独立游戏平台游戏工程",
  "engines":{"node":">=20"},
  "scripts":{
    "build":"node scripts/build-standalone-game.mjs",
    "build:standalone-game":"npm run build",
    "start":"node dist/server.mjs",
    "dev":"npm run build && node --watch dist/server.mjs",
    "test":"node --test tests/*.test.js",
    "validate:game-manifest":"node scripts/validate-game-manifest.mjs",
    "verify":"npm run validate:game-manifest && npm run build && npm test"
  }
}
